    {
      "name": "Checkout & Paystack",
      "item": [
        {
          "name": "Start checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "checkout"
              ]
            },
            "description": "Creates a PENDING order from the cart and returns Paystack's authorizationUrl. Open it in a browser to pay with a Paystack test card.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"note\": \"Gift wrap please\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d) { pm.environment.set('reference', d.reference); pm.environment.set('orderId', d.orderId); console.log('Pay here:', d.authorizationUrl); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/verify/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "verify",
                "{{reference}}"
              ]
            },
            "description": "Re-checks the transaction with Paystack. Marks the order PAID if successful (idempotent)."
          }
        }
      ]
    },
