# Copy to apps/api/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Public URL of the storefront (CORS, Paystack callback, links in emails)
WEB_URL=http://localhost:3000

# ── Supabase Postgres ── Dashboard → Connect → ORMs → Prisma
# Pooled "transaction" connection (port 6543), used by the running app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/"session" connection (port 5432), used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (product images) ── Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Auth ──
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=ash_session
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Leave empty. Only needed if the browser talks to the API directly on a sibling subdomain.
COOKIE_DOMAIN=
# Number of proxies in front of the API (for correct client IPs in rate limiting).
# Local: 1 (the Next.js /api rewrite). Vercel → Render/Railway: 2.
TRUST_PROXY=1

# ── Resend (login codes + order emails) ── https://resend.com/api-keys
# Leave empty in development to print emails (and login codes) to the API console instead.
RESEND_API_KEY=
MAIL_FROM="AuraScentHaus <onboarding@resend.dev>"

# ── Paystack ── https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxx

# ── Seed ── this email becomes SUPER_ADMIN when you run `npm run db:seed`
SEED_SUPER_ADMIN_EMAIL=you@example.com
